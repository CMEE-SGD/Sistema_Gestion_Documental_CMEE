generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. ROL
// ==========================================
model Rol {
  id                        Int      @id @default(autoincrement())
  codigo                    String   @unique @db.VarChar(20)
  nombre                    String   @db.VarChar(150)
  funciones                 String?  @db.Text
  educacion_indispensable   String?  @db.Text
  educacion_deseable        String?  @db.Text
  formacion_indispensable   String?  @db.Text
  formacion_deseable        String?  @db.Text
  capacidades_indispensable String?  @db.Text
  capacidades_deseable      String?  @db.Text
  experiencia_indispensable String?  @db.Text
  experiencia_deseable      String?  @db.Text
  orden                     Int?     @default(0) @db.SmallInt
  activo                    Boolean  @default(true)
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relación N:M con Persona
  personas Persona[] @relation("PersonaRoles")

  logs_auditoria Auditoria[]

  @@map("rol")
}

// ==========================================
// 2. DEPARTAMENTO
// ==========================================
model Departamento {
  id          Int     @id @default(autoincrement())
  codigo      String  @unique @db.VarChar(20)
  nombre      String  @db.VarChar(200)
  tipo        String  @default("Departamento") @db.VarChar(50)
  descripcion String? @db.Text

  // Jerarquía recursiva
  dependencia_id Int?
  padre          Departamento?  @relation("DeptoJerarquia", fields: [dependencia_id], references: [id])
  hijos          Departamento[] @relation("DeptoJerarquia")

  // FK Diferida a Persona (Responsable)
  responsable_id Int?
  responsable    Persona? @relation("DeptoResponsable", fields: [responsable_id], references: [id])

  orden     Int?     @default(0) @db.SmallInt
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  puestos_asignados PersonaPuesto[]
  carpetas_permisos CarpetaPermiso[]

  @@index([dependencia_id])
  @@map("departamento")
}

// ==========================================
// 3. PUESTO
// ==========================================
model Puesto {
  id                             Int      @id @default(autoincrement())
  codigo                         String   @unique @db.VarChar(20)
  nombre                         String   @db.VarChar(200)
  educacion                      String?  @db.Text
  formacion                      String?  @db.Text
  habilidad                      String?  @db.Text
  experiencia                    String?  @db.Text
  conocimiento_tecnico           String?  @db.Text
  calificacion                   String?  @db.Text
  autoridad                      String?  @db.Text
  responsabilidades              String?  @db.Text
  funcion_principal              String?  @db.Text
  funciones_alternas             String?  @db.Text
  funciones                      String?  @db.Text
  perfil_educacion_indispensable String?  @db.Text
  perfil_formacion_deseable      String?  @db.Text
  perfil_capacidades_deseable    String?  @db.Text
  perfil_experiencia_deseable    String?  @db.Text

  // Jerarquía recursiva
  dependencia_id Int?
  padre          Puesto?  @relation("PuestoJerarquia", fields: [dependencia_id], references: [id])
  hijos          Puesto[] @relation("PuestoJerarquia")

  orden            Int?     @default(0) @db.SmallInt
  activo           Boolean  @default(true)
  fecha_ultima_mod DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  personas_asignadas PersonaPuesto[]

  logs_auditoria Auditoria[]

  @@index([dependencia_id])
  @@map("puesto")
}

// ==========================================
// 4. PERSONA
// ==========================================
// Definición de los tres estados requeridos para el personal
enum EstadoPersona {
  ACTIVO
  INACTIVO
  SUSPENDIDO
}

model Persona {
  id               Int            @id @default(autoincrement())
  grado            String?        @db.VarChar(30)  // Reemplaza a 'saludo' para registrar grados militares/profesionales abreviados
  nombre           String         @db.VarChar(100)
  apellidos        String         @db.VarChar(100)
  cedula_identidad String?        @unique @db.VarChar(20)
  fecha_nacimiento DateTime?      @db.Date
  sexo             String?        @db.Char(1)      // Soporta 'M', 'F', 'O' (Otros)
  domicilio        String?        @db.VarChar(250)
  ciudad           String?        @db.VarChar(100)
  provincia        String?        @db.VarChar(100) // Se manejará como texto, el desplegable se valida en Frontend
  celular_1        String?        @db.VarChar(20)  // Reemplaza a 'telefono' fijo
  celular_2        String?        @db.VarChar(20)  // Reemplaza a 'fax'
  email_1          String?        @db.VarChar(150)
  email_2          String?        @db.VarChar(150)
  foto_ruta        String?        @db.VarChar(500)
  hoja_vida_ruta   String?        @db.VarChar(500)
  tipo_recurso     String?        @default("Usuario del sistema") @db.VarChar(50)
  fecha_alta       DateTime       @default(dbgenerated("CURRENT_DATE")) @db.Date
  idioma           String?        @default("Idioma por defecto del centro") @db.VarChar(50)
  
  // Cambio de booleano a Enum de 3 estados
  estado           EstadoPersona  @default(ACTIVO)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relaciones inversas (Se mantienen intactas)
  usuario                  Usuario?
  puestos                  PersonaPuesto[]
  documentos               DocumentoPersona[]
  deptos_responsable       Departamento[]     @relation("DeptoResponsable")
  roles                    Rol[]              @relation("PersonaRoles")
  carpetas_permisos        CarpetaPermiso[]
  laboratorios_responsable Laboratorio[]
  logs_recibidos           Auditoria[]        @relation("LogPersonaAfectada")
  fases_participadas       FaseParticipante[]

  @@map("persona")
}

// ==========================================
// 5. USUARIO
// ==========================================
model Usuario {
  id         Int     @id @default(autoincrement())
  persona_id Int     @unique
  persona    Persona @relation(fields: [persona_id], references: [id], onDelete: Cascade)

  // -- Tab 1: Nuevo usuario --
  nombre_usuario  String    @unique @db.VarChar(80)
  fecha_caducidad DateTime? @db.Date
  estado_cuenta   Boolean   @default(true)
  bloqueado       Boolean   @default(false)
  grupos          Grupo[]   @relation("UsuarioGrupos")

  // -- Tab 2: Clave --
  password_hash              String  @db.VarChar(255)
  cambiar_clave_proxima_sesion Boolean @default(false)

  auditorias Auditoria[] 

  // -- Tab 3: Configuración --
  idioma              String? @db.VarChar(50)
  acceso_preferencias Boolean @default(false)
  acceso_chat         Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([nombre_usuario])
  @@map("usuario")
}

// ==========================================
// 6. PERSONA_PUESTO
// ==========================================
model PersonaPuesto {
  id Int @id @default(autoincrement())

  persona_id Int
  persona    Persona @relation(fields: [persona_id], references: [id], onDelete: Cascade)

  puesto_id Int
  puesto    Puesto @relation(fields: [puesto_id], references: [id], onDelete: Restrict)

  departamento_id Int
  departamento    Departamento @relation(fields: [departamento_id], references: [id], onDelete: Restrict)

  orden_puesto     Int      @db.SmallInt
  fecha_asignacion DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  activo           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([persona_id, puesto_id], name: "uq_persona_puesto")
  @@unique([persona_id, orden_puesto], name: "uq_persona_orden_puesto")
  @@index([persona_id])
  @@index([puesto_id])
  @@map("persona_puesto")
}

// ==========================================
// 7. DOCUMENTOS_PERSONA
// ==========================================
model DocumentoPersona {
  id             Int      @id @default(autoincrement())
  persona_id     Int
  persona        Persona  @relation(fields: [persona_id], references: [id], onDelete: Cascade)
  nombre_archivo String   @db.VarChar(300)
  ruta           String   @db.VarChar(500)
  tipo_documento String?  @db.VarChar(100) // Ej: "CV", "Certificado", "Contrato"
  peso_bytes     Int?     // <-- Nuevo campo recomendado
  fecha_subida   DateTime @default(now()) @db.Timestamptz
  activo         Boolean  @default(true)

  @@index([persona_id])
  @@map("documento_persona")
}

// ==========================================
// 8. GRUPO
// ==========================================
model Grupo {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique @db.VarChar(100)
  descripcion String? @db.Text
  activo      Boolean @default(true)

  // Relación N:M implícita con Usuarios
  usuarios Usuario[] @relation("UsuarioGrupos")

  // Relación 1:N hacia la tabla intermedia para los niveles por aplicación
  aplicaciones GrupoAplicacion[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("grupo")
}

// ==========================================
// 9. APLICACION (Catálogo de Módulos)
// ==========================================
model Aplicacion {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique @db.VarChar(100) // Ej: "Recursos Humanos", "Gestor Documental"
  descripcion String? @db.Text
  activo      Boolean @default(true)

  // Relación inversa a la tabla intermedia
  grupos GrupoAplicacion[]

  @@map("aplicacion")
}

// ==========================================
// 10. GRUPO_APLICACION (Tabla Intermedia)
// ==========================================
model GrupoAplicacion {
  id Int @id @default(autoincrement())

  grupo_id Int
  grupo    Grupo @relation(fields: [grupo_id], references: [id], onDelete: Cascade)

  aplicacion_id Int
  aplicacion    Aplicacion @relation(fields: [aplicacion_id], references: [id], onDelete: Cascade)

  // Aquí guardamos el nivel de permiso según el PDF (1 al 5)
  nivel Int @db.SmallInt

  // El orden de aparición en el menú (ej: 510, 40, 20)
  orden Int? @default(0) @db.SmallInt

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Un grupo no puede tener la misma aplicación asignada dos veces
  @@unique([grupo_id, aplicacion_id])
  @@index([grupo_id])
  @@index([aplicacion_id])
  @@map("grupo_aplicacion")
}

// =========================================================================
// MÓDULO 2: GESTIÓN DOCUMENTAL (Biblioteca, Carpetas y Archivos)
// =========================================================================

enum TipoNivelCarpeta {
  LIBRERIA     
  AREA         
  SUBCARPETA   
}

enum CircuitoDocumento {
  SIN_CLASIFICAR
  ALTA_FRECUENCIA
  ATENCION_AL_CLIENTE
  BAJA_FRECUENCIA
  CALIDAD
  CAPACITACION
  CUALIFICACION
  FORMATOS
  GESTION_DE_PATRONES
  GESTION_LOGISTICA
  LEGALIZACION
  PRESION
  PROCEDIMIENTOS_GESTION_DOCUMENTAL
  TERMOMETRIA
  TIEMPO
}

model Documento {
  id                 Int               @id @default(autoincrement())
  
  // -- Campos del Formulario "Nuevo Fichero" --
  empresa            String?           @default("Centro de Metrología del Ejército Ecuatoriano") @db.VarChar(200)
  fecha_documento    DateTime?         @db.Date // La fecha que sale a la derecha (01/06/2026)
  circuito           CircuitoDocumento @default(SIN_CLASIFICAR)
  activo             Boolean           @default(true) // El checkbox de "Estado"
  propietario        String?           @db.VarChar(150)
  
  // Fichero
  archivo_url        String            // Aquí va la ruta donde se guardó el PDF (/uploads/...)
  nombre             String            // Es el "Título" del formulario
  version            String?           @default("1")
  
  // -- Campos internos --
  codigo             String?           @db.VarChar(50)
  orden              Int               @default(0)
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt

  // Carpeta contenedora
  carpeta_id         Int
  carpeta            Carpeta           @relation(fields: [carpeta_id], references: [id], onDelete: Cascade)

  // Relaciones entre documentos (Botón: Relaciones de documentos)
  documentos_origen  DocumentoRelacion[] @relation("DocOrigen")
  documentos_destino DocumentoRelacion[] @relation("DocDestino")

  logs_auditoria Auditoria[]

  @@map("documentos")
}

model DocumentoRelacion {
  id               Int       @id @default(autoincrement())
  doc_origen_id    Int
  doc_destino_id   Int
  tipo_relacion    String?   // Ej: "Sustituye a", "Anexo de", "Complementa a"

  doc_origen       Documento @relation("DocOrigen", fields: [doc_origen_id], references: [id], onDelete: Cascade)
  doc_destino      Documento @relation("DocDestino", fields: [doc_destino_id], references: [id], onDelete: Cascade)

  @@map("documentos_relaciones")
}

// -------------------------------------------------------------------------
// ROLES Y SEGURIDAD EXCLUSIVA DE LA BIBLIOTECA DOCUMENTAL
// -------------------------------------------------------------------------

model RolCarpeta {
  id          Int      @id @default(autoincrement())
  nombre      String   // Ej: "Solo Lector", "Editor de Área", "Administrador Documental"
  descripcion String?  // Nivel de Privilegios asignado (1 al 5):
  
  // 1: Ver | 2: Ver y Descargar | 3: Ver, Descargar y Editar 
  // 4: Ver, Descargar, Editar y Mover | 5: Todos los privilegios (+Eliminar)
  nivel       Int      @default(1) 
  
  activo      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("roles_carpetas")
}

model Carpeta {
  id               Int              @id @default(autoincrement())
  nombre           String           
  descripcion      String?          @db.Text
  codigo           String?          @db.VarChar(50)
  version_inicial  String?          @default("1")
  etiquetas        String?          @db.Text
  
  tipo             TipoNivelCarpeta @default(SUBCARPETA)
  orden            Int              @default(0)
  activo           Boolean          @default(true)
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt

  carpeta_padre_id Int?
  carpeta_padre    Carpeta?         @relation("JerarquiaCarpetas", fields: [carpeta_padre_id], references: [id], onDelete: Cascade)
  subcarpetas      Carpeta[]        @relation("JerarquiaCarpetas")
  
  documentos       Documento[]
  permisos         CarpetaPermiso[]

  @@map("carpetas")
}

model CarpetaPermiso {
  id               Int        @id @default(autoincrement())
  carpeta_id       Int
  
  // Ahora el permiso se asigna a un Departamento O a una Persona
  departamento_id  Int?
  persona_id       Int?

  // Nivel de acceso (Dropdown: Ver, Ver y Descargar, Todos los privilegios...)
  nivel_permiso    Int        @default(1) 
  
  // Los 3 checkboxes de la derecha (Word, Carpeta, Plus)
  permiso_docs     Boolean    @default(false) 
  permiso_carpetas Boolean    @default(false)
  permiso_extra    Boolean    @default(false)

  carpeta          Carpeta       @relation(fields: [carpeta_id], references: [id], onDelete: Cascade)
  departamento     Departamento? @relation(fields: [departamento_id], references: [id], onDelete: Cascade)
  persona          Persona?      @relation(fields: [persona_id], references: [id], onDelete: Cascade)

  @@map("carpetas_permisos")
}

// ==========================================
// 11. BITÁCORA DE ACCESOS Y AUDITORÍA (LOGS)
// ==========================================
model Auditoria {
  id                  Int      @id @default(autoincrement())
  
  // Quién realiza la acción (Obligatorio)
  usuario_id          Int
  usuario             Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Restrict)

  // Qué se hizo
  modulo              String   @db.VarChar(50)  // Ej: "RRHH", "GESTOR_DOCUMENTAL"
  accion              String   @db.VarChar(100) // Ej: "Ver ficha de recurso", "Descarga del documento"
  descripcion         String?  @db.Text         // Ej: "De: Carpeta A -> A: Carpeta B" o IPs

  // Vínculo al Gestor Documental (Opcional)
  documento_id        Int?
  documento           Documento? @relation(fields: [documento_id], references: [id], onDelete: Cascade)

  // Vínculo a RRHH (Opcional - a quién le editaron o vieron la ficha)
  persona_afectada_id Int?
  persona_afectada    Persona?   @relation("LogPersonaAfectada", fields: [persona_afectada_id], references: [id], onDelete: Cascade)

  rol_afectado_id     Int?
  rol_afectado        Rol?       @relation(fields: [rol_afectado_id], references: [id], onDelete: Cascade)

  puesto_afectado_id  Int?
  puesto_afectado     Puesto?    @relation(fields: [puesto_afectado_id], references: [id], onDelete: Cascade)

  fecha_hora          DateTime @default(now()) @db.Timestamptz

  @@index([usuario_id])
  @@index([documento_id])
  @@index([modulo])
  @@map("auditoria")
}

// ==========================================
// 12. LABORATORIO
// ==========================================
model Laboratorio {
  id             Int       @id @default(autoincrement())
  codigo         String?   @unique @db.VarChar(20)
  nombre         String    @unique @db.VarChar(100) // Ej: Laboratorio de Masa, Laboratorio de Temperatura
  descripcion    String?   @db.Text
  activo         Boolean   @default(true)

  // FK a Persona (Responsable técnico del laboratorio)
  responsable_id Int?
  responsable    Persona?  @relation(fields: [responsable_id], references: [id], onDelete: Restrict)

  equipos        Equipo[]
  servicios      Servicio[]

  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([responsable_id])
  @@map("laboratorio")
}

// ==========================================
// 13. EQUIPO (Inventario de instrumentos)
// ==========================================
model Equipo {
  id             Int          @id @default(autoincrement())
  codigo         String       @unique @db.VarChar(50) // Código de inventario CMEE
  nombre         String       @db.VarChar(150)
  marca          String?      @db.VarChar(100)
  modelo         String?      @db.VarChar(100)
  numero_serie   String?      @db.VarChar(100)
  estado         EstadoEquipo @default(OPERATIVO)

  // Relación con el Laboratorio
  laboratorio_id Int
  laboratorio    Laboratorio  @relation(fields: [laboratorio_id], references: [id], onDelete: Restrict)

  activo         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  @@index([laboratorio_id])
  @@map("equipo")
}

// ==========================================
// 14. SERVICIO (Magnitudes ofertadas)
// ==========================================
model Servicio {
  id             Int       @id @default(autoincrement())
  nombre         String    @db.VarChar(200) // Ej: Calibración de balanzas analíticas
  magnitud       String?   @db.VarChar(100) // Ej: Masa, Volumen, Presión
  descripcion    String?   @db.Text

  // Relación con el Laboratorio
  laboratorio_id Int
  laboratorio    Laboratorio @relation(fields: [laboratorio_id], references: [id], onDelete: Restrict)

  activo         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([laboratorio_id])
  @@map("servicio")
}

// Enum para el control de los equipos
enum EstadoEquipo {
  OPERATIVO
  EN_CALIBRACION
  FUERA_DE_SERVICIO
}
// 12. CONFIGURACIÓN DE CIRCUITOS Y FASES
// ==========================================
model Circuito {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique @db.VarChar(100) // Ej: CALIDAD, PRESIÓN
  activo      Boolean  @default(true)

  fases       Fase[]

  @@map("circuitos")
}

model Fase {
  id                     Int      @id @default(autoincrement())
  circuito_id            Int
  circuito               Circuito @relation(fields: [circuito_id], references: [id], onDelete: Cascade)

  nombre                 String   @db.VarChar(100) // Ej: ELABORACIÓN, APROBACIÓN
  orden                  Int      @default(10)

  etiqueta_singular      String?  @db.VarChar(100) // Ej: ELABORACIÓN
  etiqueta_plural        String?  @db.VarChar(100) // Ej: ELABORACIONES

  individual_paralelo    Boolean  @default(false)
  mostrar_hora           Boolean  @default(true)
  ocultar_enviar_correo  Boolean  @default(false)
  activo                 Boolean  @default(true)
  en_vigor               Boolean  @default(false)
  obligatorio_todos      Boolean  @default(false)

  participantes          FaseParticipante[]

  @@map("fases")
}

model FaseParticipante {
  id          Int      @id @default(autoincrement())
  fase_id     Int
  fase        Fase     @relation(fields: [fase_id], references: [id], onDelete: Cascade)
  
  persona_id  Int
  persona     Persona  @relation(fields: [persona_id], references: [id], onDelete: Cascade)

  @@unique([fase_id, persona_id])
  @@map("fases_participantes")
}