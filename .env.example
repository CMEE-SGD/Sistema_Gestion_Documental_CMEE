# Postgres
POSTGRES_USER=cmee_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=cmee_sgd

# Backend
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:8080

# Usuario "God" (bypass total de permisos) - usa credenciales propias y fuertes
# para producción, no reutilices las de desarrollo local.
GOD_USERNAME=change_me
GOD_PASSWORD=change_me_to_a_long_random_string

# Frontend (build-time)
VITE_API_URL=http://localhost:3001/api
# Usada para construir URLs directas a archivos (fotos, PDFs) y la conexión de WebSocket.
VITE_BACKEND_URL=http://localhost:3001

# En producción, con Caddy al frente (ver Caddyfile), usa el mismo dominio/IP para las tres:
# FRONTEND_URL=https://tu-dominio.com
# VITE_API_URL=https://tu-dominio.com/api
# VITE_BACKEND_URL=https://tu-dominio.com
